---
import ArsLayout from "@/layouts/ArsLayout.astro";
import LoginRequired from "@/components/ars/LoginRequired.astro";
import ArsAuth from "@/components/ars/ArsAuth.astro";
import { fetchArsPost } from "@/lib/ars/posts";

// Permalink corto sin username (https://arsmate.com/post/<id>). Resolvemos el
// autor con la API de Arsmate (que devuelve el post solo con el postId) y
// redirigimos a la URL canónica /<username>/post/<id>, que ya tiene toda la
// lógica del detalle.
const { postId } = Astro.params as { postId: string };
const arsmateCookie = Astro.locals.arsmateCookie;

// Sin sesión no se puede resolver el post: invitamos a iniciar sesión.
const hasSession = !!arsmateCookie;

let username: string | null = null;
if (hasSession) {
  try {
    // Llamada directa, sin loopback HTTP (ver src/lib/ars/posts.ts).
    const result = await fetchArsPost(postId, null, arsmateCookie);
    const post = (result.data as { post?: any } | undefined)?.post;
    if (post) {
      username = post.author?.username || post.user?.username || null;
    }
  } catch (e) {
    console.error("Error resolviendo post -> creador:", e);
  }

  if (username) {
    return Astro.redirect(`/ars/${username.trim()}/post/${postId}`);
  }
}
---

<ArsLayout
  title={hasSession
    ? "Publicación no encontrada - Arsmate"
    : "Inicia sesión - Arsmate"}
  bodyClass="bg-gray-100 dark:bg-[#0a0a0a] min-h-screen font-sans text-gray-800 dark:text-slate-200"
>
  {/* Avatar arriba a la derecha para que el botón de login tenga a quién hablarle. */}
  <div class="absolute top-4 right-4 z-50">
    <ArsAuth />
  </div>

  {
    hasSession ? (
      <div class="min-h-screen flex flex-col items-center justify-center px-4 text-center">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-slate-100 mb-2">
          Publicación no encontrada
        </h1>
        <p class="text-gray-600 dark:text-slate-300 mb-8">
          No pudimos localizar la publicación #{postId}.
        </p>
        <a
          href="/ars"
          class="px-6 py-2 bg-purple-600 text-white rounded-full font-bold shadow-md hover:bg-purple-700 transition-colors"
        >
          Volver al Inicio
        </a>
      </div>
    ) : (
      <div class="min-h-screen flex flex-col items-center justify-center">
        <LoginRequired message="Necesitas una sesión para ver esta publicación." />
      </div>
    )
  }
</ArsLayout>
