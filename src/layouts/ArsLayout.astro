---
import "@/styles/ars.css";

interface Props {
  /** Contenido del <title>. */
  title?: string;
  /** Clases aplicadas al <body>. */
  bodyClass?: string;
  /** Idioma del documento. */
  lang?: string;
  /** Atributos extra para el <body> (p.ej. data-username). */
  bodyAttrs?: Record<string, unknown>;
}

const {
  title = "Arsmate",
  bodyClass = "bg-gray-100 dark:bg-[#0a0a0a] min-h-screen font-sans text-gray-800 dark:text-slate-200 transition-colors",
  lang = "es",
  bodyAttrs = {},
} = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <script is:inline>
      // Aplica el tema antes de pintar para evitar el flash de color (FOUC).
      (function () {
        try {
          const stored = localStorage.getItem("ars-theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          if (stored === "dark" || (!stored && prefersDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (e) {}
      })();

      // Toggle de tema global vía delegación: cualquier elemento con
      // [data-theme-toggle] alterna el modo oscuro y lo persiste.
      document.addEventListener("click", function (e) {
        const toggle = e.target.closest && e.target.closest("[data-theme-toggle]");
        if (!toggle) return;
        const isDark = document.documentElement.classList.toggle("dark");
        try {
          localStorage.setItem("ars-theme", isDark ? "dark" : "light");
        } catch (err) {}
      });
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass} {...bodyAttrs}>
    <slot />
  </body>
</html>
