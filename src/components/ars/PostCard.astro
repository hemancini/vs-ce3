---
import { getProxiedUrl } from "@/utils/ars/proxy";
import { formatNumber, linkifyDescription } from "@/utils/ars/formatters";

interface Props {
  post: any;
  username: string;
  isDetail?: boolean;
}

const { post, isDetail = false } = Astro.props;
// Algunos usernames de Arsmate vienen con espacios al final; se limpian para
// no ensuciar las URLs de navegación (perfil y detalle del post).
const username = (Astro.props.username || "").trim();

// --- Helpers (portados de PostCard.tsx) ---
const formatDate = (dateStr: string) => {
  if (!dateStr) return "Reciente";
  const postDate = new Date(dateStr);
  const now = new Date();
  if (postDate.toDateString() === now.toDateString()) return "Hoy";
  const yesterday = new Date(now);
  yesterday.setDate(now.getDate() - 1);
  if (postDate.toDateString() === yesterday.toDateString()) return "Ayer";
  return postDate.toLocaleDateString("es-CL", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
};

// --- Media logic (misma que PostCard.tsx) ---
let allMedia: any[] = [];

const validatedRawMedia = Array.isArray(post.rawMedia)
  ? post.rawMedia.filter((m: any) => {
      if (!m) return false;
      if (m.type === "video")
        return !!(m.video || m.hlsManifestUrl || m.videoUrl);
      return true;
    })
  : [];

const sources = [
  post.mediaItems,
  post.contentImages,
  post.content?.images,
  post.media ? (Array.isArray(post.media) ? post.media : [post.media]) : [],
  validatedRawMedia,
];

sources.forEach((source) => {
  if (source && Array.isArray(source)) {
    source.forEach((item) => {
      if (!item) return;
      const existing = allMedia.find(
        (m) =>
          (m.id && item.id && m.id === item.id) ||
          (m.url && item.url && m.url === item.url),
      );
      if (existing) {
        Object.keys(item).forEach((key) => {
          if (item[key] && !existing[key]) existing[key] = item[key];
          if (
            typeof item[key] === "string" &&
            item[key].includes("://") &&
            typeof existing[key] === "string" &&
            !existing[key].includes("://")
          ) {
            existing[key] = item[key];
          }
        });
      } else {
        allMedia.push({ ...item });
      }
    });
  }
});

const seenMediaIds = new Set();
allMedia = allMedia
  .filter((media: any) => {
    const uniqueId =
      media.id || media.url || media.thumbnail || media.videoUrl || media.image;
    if (!uniqueId || seenMediaIds.has(uniqueId)) return false;
    seenMediaIds.add(uniqueId);
    return true;
  })
  .sort((a, b) => (a.index || 0) - (b.index || 0));

const isActuallyLocked =
  post.isLocked ||
  (post.contentType === "Suscripción" && !post.hasAccess) ||
  (post.locked === "yes" && !post.hasAccess);

// El feed fuerza el desbloqueo (isLocked/hasAccess) para mostrar el media, así
// que para el badge usamos el estado real preservado por la API. Fallback al
// cálculo local por si el post no viene del feed.
const realPrice = Number(post.realPrice ?? post.price) || 0;
const isPremium =
  post.isPremiumContent ??
  (post.isLocked ||
    post.contentType === "Suscripción" ||
    post.locked === "yes" ||
    realPrice > 0);

// Descriptores por media para mantener el template limpio.
const mediaViews = allMedia
  .map((media: any, idx: number) => {
  const isAudio =
    media.type === "audio" || media.type === "music" || !!media.music;

  if (isAudio) {
    const audioSrc =
      media.proxiedUrl || (media.url ? getProxiedUrl(media.url) : null);
    // Sin fuente reproducible: lo descartamos (no fingimos "exclusivo").
    if (!audioSrc) return { kind: "skip" as const };
    if (isActuallyLocked && !post.hasAccess)
      return { kind: "exclusive" as const };
    return {
      kind: "audio" as const,
      src: audioSrc,
      fileName: media.fileName || media.file_name || "Nota de voz",
    };
  }

  const isVideo =
    media.type === "video" || (post.postType === "video" && media.videoSource);

  if (isVideo) {
    // Contenido bloqueado sin acceso: el videoSource es un fallback "adivinado"
    // (espejo HLS público por id) que para suscripción no existe (404). No
    // armamos un player roto; mostramos el overlay exclusivo como audio/imagen.
    if (isActuallyLocked && !post.hasAccess) return { kind: "exclusive" as const };

    const rawVideoUrl =
      media.videoSource ||
      media.videoUrl ||
      media.hlsManifestUrl ||
      media.video ||
      post.hlsManifestUrl;
    const videoSrc = media.videoSource
      ? media.videoSource
      : rawVideoUrl
        ? getProxiedUrl(rawVideoUrl)
        : null;
    if (!videoSrc) return { kind: "exclusive" as const };

    const mediaId = String(media.id || idx);
    const hasPreview = !!media.previewGifUrl;
    const staticThumbnail =
      media.thumbnailUrl || media.proxiedThumbnail || media.thumbnail || "";
    const videoMime =
      media.videoMime ||
      (String(videoSrc).includes(".mp4")
        ? "video/mp4"
        : "application/x-mpegURL");
    const thumbProxied =
      getProxiedUrl(media.thumbnail || media.proxiedThumbnail) || "";

    return {
      kind: "video" as const,
      videoSrc,
      mediaId,
      hasPreview,
      previewGifUrl: media.previewGifUrl || "",
      staticThumbnail,
      videoMime,
      thumbProxied,
    };
  }

  const rawUrl =
    [media.url, media.proxiedUrl, media.thumbnail, media.image].find(
      (u) => typeof u === "string" && u.includes("://"),
    ) ||
    media.proxiedUrl ||
    media.url ||
    media.thumbnail ||
    media.image;
  const src = getProxiedUrl(rawUrl);

  if (!src) return { kind: "exclusive" as const };
  if (isActuallyLocked && !post.hasAccess)
    return { kind: "locked" as const, src };
  return { kind: "image" as const, src };
  })
  .filter((m: any) => m.kind !== "skip");

const hasText = !!(post.text || post.description);
---

<div
  class:list={[
    "post-card relative block bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100 hover:shadow-md transition-all duration-300",
    !isDetail && "hover:border-blue-200 cursor-pointer",
  ]}
  data-post-id={post.id}
  data-username={username}
  data-is-detail={isDetail ? "true" : "false"}
>
  <header class="p-4 flex justify-between items-center border-b border-gray-50">
    <div
      class="relative z-10 flex items-center gap-2 cursor-pointer"
      data-profile-link={username}
    >
      <div
        class="w-8 h-8 rounded-full bg-gray-200 overflow-hidden shadow-inner"
      >
        <img
          src={getProxiedUrl(post.creatorAvatar || post.user?.avatar)}
          class="w-full h-full object-cover"
          alt="Avatar"
        />
      </div>
      <div>
        <a
          href={`/ars/${username}`}
          class="font-bold text-sm text-gray-900 hover:text-blue-600 hover:underline transition-colors"
        >
          {post.creatorName || post.user?.username || username}
        </a>
        <p
          class="text-[10px] text-gray-500 uppercase tracking-tight font-medium"
        >
          {formatDate(post.date || post.createdAt)}
        </p>
      </div>
    </div>
    <div class="flex gap-3 text-xs text-gray-500">
      <span class="flex items-center gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-3.5 h-3.5 text-red-500 fill-red-500/10"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
          ></path>
        </svg>
        {formatNumber(post.likes_count || post.likes || 0)}
      </span>
      <span class="flex items-center gap-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-3.5 h-3.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785c-.442.483.068 1.228.694 1.053 1.554-.432 3.101-1.126 4.312-1.733.454-.227.94-.342 1.442-.342H12Z"
          ></path>
        </svg>
        {formatNumber(post.comments_count || post.comments || 0)}
      </span>
    </div>
  </header>

  <div class="p-4">
    {
      hasText && (
        <p
          class="relative z-10 text-sm text-gray-800 whitespace-pre-wrap mb-4"
          set:html={linkifyDescription(post.text || post.description)}
        />
      )
    }

    {
      mediaViews.length > 0 && (
        <div
          class:list={[
            mediaViews.length > 1 ? "grid grid-cols-2 gap-1" : "block",
            "relative z-10 rounded-lg overflow-hidden border border-gray-100",
          ]}
        >
          {mediaViews.map((m: any) => {
            if (m.kind === "audio") {
              return (
                <div class="audio-player p-4 bg-gradient-to-br from-gray-50 to-gray-100">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="w-12 h-12 rounded-full bg-white border border-blue-200 flex items-center justify-center text-blue-500 shrink-0 shadow-sm">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="1.5"
                        stroke="currentColor"
                        class="w-6 h-6"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M9 9l10.5-3m0 6.553v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 1 1-.99-3.467l2.31-.66a2.25 2.25 0 0 0 1.632-2.163V8.547Zm0 0V5.25A2.25 2.25 0 0 0 17.25 3h-1.5a2.25 2.25 0 0 0-2.25 2.25v10.303m0 0v3.75a2.25 2.25 0 0 1-1.632 2.163l-1.32.377a1.803 1.803 0 0 1-.99-3.467l2.31-.66A2.25 2.25 0 0 0 13.5 15.553Z"
                        />
                      </svg>
                    </div>
                    <div class="min-w-0">
                      <p class="font-semibold text-sm text-gray-900 leading-tight">
                        Nota de voz
                      </p>
                      <p class="text-xs text-gray-500">Audio</p>
                    </div>
                  </div>

                  <div class="flex items-center gap-3">
                    <button
                      type="button"
                      class="audio-play w-10 h-10 rounded-full bg-blue-500 hover:bg-blue-600 text-white flex items-center justify-center shrink-0 transition-colors"
                      aria-label="Reproducir"
                    >
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        class="audio-icon-play w-5 h-5 ml-0.5"
                      >
                        <path d="M8 5v14l11-7z" />
                      </svg>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        class="audio-icon-pause w-5 h-5 hidden"
                      >
                        <path d="M6 5h4v14H6zM14 5h4v14h-4z" />
                      </svg>
                    </button>
                    <span class="audio-time text-xs text-gray-600 tabular-nums shrink-0">
                      0:00 / 0:00
                    </span>
                    <input
                      type="range"
                      class="audio-seek flex-1 min-w-0 accent-blue-500 cursor-pointer"
                      min="0"
                      max="0"
                      step="0.1"
                      value="0"
                      aria-label="Progreso del audio"
                    />
                  </div>

                  <div class="flex items-center gap-2 mt-3">
                    <span class="text-xs text-gray-500">Velocidad:</span>
                    <select class="audio-speed text-xs border border-gray-200 rounded px-1.5 py-0.5 bg-white text-gray-700 cursor-pointer">
                      <option value="0.5">0.5x</option>
                      <option value="1" selected>
                        1x
                      </option>
                      <option value="1.5">1.5x</option>
                      <option value="2">2x</option>
                    </select>
                  </div>

                  <audio class="audio-el" preload="none" src={m.src} />
                </div>
              );
            }

            if (m.kind === "exclusive") {
              return (
                <div class="aspect-square bg-black/10 flex items-center justify-center relative overflow-hidden">
                  <div class="absolute inset-0 backdrop-blur-xl bg-black/40 flex flex-col items-center justify-center text-white p-6 text-center">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-10 h-10 mb-4"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                      />
                    </svg>
                    <p class="font-bold text-lg mb-2">Contenido Exclusivo</p>
                    <p class="text-sm opacity-90">
                      {post.price && post.price > 0
                        ? `Compra por $${post.price} USD`
                        : "Suscríbete para ver"}
                    </p>
                  </div>
                </div>
              );
            }

            if (m.kind === "locked") {
              return (
                <div class="aspect-square bg-black/10 flex items-center justify-center relative overflow-hidden">
                  <img
                    src={m.src}
                    class="w-full h-full object-cover blur-3xl opacity-50"
                    alt="Locked content"
                  />
                  <div class="absolute inset-0 flex flex-col items-center justify-center text-white p-6 text-center bg-black/20">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.5"
                      stroke="currentColor"
                      class="w-8 h-8 mb-2"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                      />
                    </svg>
                    <p class="text-xs font-bold uppercase tracking-widest">
                      {post.price > 0 ? `Comprar $${post.price}` : "Subs"}
                    </p>
                  </div>
                </div>
              );
            }

            if (m.kind === "image") {
              return (
                <div
                  class="post-image aspect-square bg-gray-100 relative overflow-hidden group cursor-zoom-in"
                  data-src={m.src}
                >
                  <img
                    src={m.src}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    alt="Post content"
                  />
                </div>
              );
            }

            // m.kind === "video"
            if (isDetail) {
              return (
                <div class="video-player-container video-wrapper aspect-square bg-black relative overflow-hidden">
                  <video
                    class="detail-video w-full h-full object-contain"
                    controls
                    preload="none"
                    playsinline
                    poster={m.thumbProxied || undefined}
                    data-hls-src={m.videoSrc}
                    data-mime={m.videoMime}
                  />
                </div>
              );
            }

            // Feed: poster sin player. Hover carga duración; click reproduce.
            return (
              <div
                class="video-poster aspect-square bg-black relative overflow-hidden group cursor-pointer select-none [-webkit-touch-callout:none]"
                data-video-src={m.videoSrc}
                data-video-mime={m.videoMime}
                data-media-id={m.mediaId}
                data-thumbnail={m.thumbProxied || m.staticThumbnail}
              >
                {m.hasPreview && m.previewGifUrl && (
                  <img
                    src={m.previewGifUrl}
                    class="absolute inset-0 w-full h-full object-cover z-10"
                    alt="Video preview"
                    loading="eager"
                  />
                )}
                {m.staticThumbnail ? (
                  <div
                    class="absolute inset-0 bg-cover bg-center bg-no-repeat"
                    style={`background-image:url(${m.staticThumbnail})`}
                  />
                ) : m.videoMime === "video/mp4" ? (
                  // Sin miniatura en los datos: mostramos el primer fotograma del
                  // MP4 como poster (fragmento #t=0.1, solo carga metadata).
                  <video
                    class="absolute inset-0 w-full h-full object-cover pointer-events-none"
                    src={`${m.videoSrc}#t=0.1`}
                    muted
                    playsinline
                    preload="metadata"
                    aria-hidden="true"
                    tabindex="-1"
                  />
                ) : (
                  <div class="absolute inset-0" />
                )}
                <div class="absolute inset-0 flex items-center justify-center z-20 bg-black/10 group-hover:bg-black/30 transition-colors">
                  <div class="w-14 h-14 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center border border-white/30 group-hover:scale-110 transition-transform">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      class="w-8 h-8 text-white ml-1"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
                <div class="video-duration absolute bottom-3 right-3 bg-black/60 px-2 py-1 rounded text-[10px] text-white font-bold uppercase tracking-wider backdrop-blur-md z-30 tabular-nums" />
              </div>
            );
          })}
        </div>
      )
    }

    <div
      class="relative z-10 mt-4 pt-4 border-t border-gray-50 flex justify-between items-center"
    >
      <button
        type="button"
        class="json-toggle text-[10px] text-gray-400 hover:text-gray-600 transition-colors uppercase tracking-widest font-bold"
      >
        Ver JSON Raw
      </button>
      <div class="flex gap-2">
        {
          isPremium ? (
            realPrice > 0 ? (
              <span class="bg-red-50 text-red-600 text-[10px] px-2 py-0.5 rounded-full font-bold border border-red-100 tracking-tighter uppercase">
                ${realPrice} USD
              </span>
            ) : (
              <span class="bg-amber-50 text-amber-600 text-[10px] px-2 py-0.5 rounded-full font-bold border border-amber-100 tracking-tighter uppercase flex items-center gap-1">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  stroke="currentColor"
                  class="w-2.5 h-2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                  />
                </svg>
                Subs
              </span>
            )
          ) : (
            <span class="bg-green-50 text-green-600 text-[10px] px-2 py-0.5 rounded-full font-bold border border-green-100 tracking-tighter uppercase">
              Gratis
            </span>
          )
        }
      </div>
    </div>

    <pre
      tabindex="0"
      class="json-content relative z-10 hidden mt-4 p-4 bg-gray-900 text-gray-100 rounded-lg text-[10px] overflow-auto max-h-60 shadow-inner select-text cursor-text outline-none">{JSON.stringify(post, null, 2)}</pre>
  </div>

  {
    !isDetail && (
      <a
        href={`/ars/${username}/post/${post.id}`}
        class="absolute inset-0 z-0"
        aria-label="Ver publicación"
      />
    )
  }
</div>
