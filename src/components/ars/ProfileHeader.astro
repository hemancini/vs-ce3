---
import { getProxiedUrl } from "@/utils/ars/proxy";
import { formatNumber } from "@/utils/ars/formatters";

/**
 * ProfileHeader component for Arsmate.
 */
interface Props {
  creator?: any;
}

const { creator } = Astro.props;

const avatar = creator ? getProxiedUrl(creator.avatar) : null;
const cover = creator ? getProxiedUrl(creator.cover) : null;
const stats = creator?.stats || {};

const statItems = [
  {
    label: "Seguidores",
    value: formatNumber(stats.subscribers || stats.followers_count),
  },
  { label: "Likes", value: formatNumber(stats.likes || stats.likes_count) },
  { label: "Fotos", value: formatNumber(stats.photos || stats.photos_count) },
  { label: "Vídeos", value: formatNumber(stats.videos || stats.videos_count) },
  { label: "Posts", value: stats.posts || stats.posts_count || 0 },
  {
    label: "Precio",
    value: creator?.freeSubscription
      ? "GRATIS"
      : `$${creator?.subscriptionPrice || 0} USD`,
  },
];
---

<div id="profile-header" class={!creator ? "animate-pulse" : ""}>
  <!-- Cover -->
  <div class="h-48 md:h-64 bg-gray-200 w-full relative group">
    {
      cover ? (
        <img src={cover} class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full bg-gradient-to-r from-blue-400 to-indigo-500" />
      )
    }
  </div>

  <!-- Avatar & Info -->
  <div
    class="px-4 -mt-12 relative flex flex-col md:flex-row md:items-end gap-4 mb-8"
  >
    <div
      class="w-32 h-32 rounded-full border-4 border-white bg-gray-300 shadow-md overflow-hidden flex-shrink-0"
    >
      {
        avatar ? (
          <img src={avatar} class="w-full h-full object-cover" />
        ) : (
          <span class="flex items-center justify-center w-full h-full text-4xl">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-12 h-12 text-gray-400"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
              />
            </svg>
          </span>
        )
      }
    </div>
    <div class="flex-grow min-w-0">
      {
        creator ? (
          <>
            <div class="flex items-start gap-2 min-w-0">
              <h2
                class="text-xl md:text-2xl font-bold text-gray-900 leading-tight line-clamp-2 break-words min-w-0"
                title={creator.name || creator.username}
              >
                {creator.name || creator.username}
              </h2>
              {creator.isVerified && (
                <span
                  class="text-blue-500 flex items-center flex-shrink-0 mt-1"
                  title="Verificado"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    class="w-5 h-5"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M8.603 3.799A4.49 4.49 0 0 1 12 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 0 1 3.498 1.307 4.491 4.491 0 0 1 1.307 3.497A4.49 4.49 0 0 1 21.75 12a4.49 4.49 0 0 1-1.549 3.397 4.491 4.491 0 0 1-1.307 3.497 4.491 4.491 0 0 1-3.497 1.307A4.49 4.49 0 0 1 12 21.75a4.49 4.49 0 0 1-3.397-1.549a4.49 4.49 0 0 1-3.498-1.306 4.491 4.491 0 0 1-1.307-3.498A4.49 4.49 0 0 1 2.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 0 1 1.307-3.497a4.49 4.49 0 0 1 3.497-1.307Zm7.007 6.387a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </span>
              )}
            </div>
            <p class="text-gray-500 text-lg truncate">@{creator.username}</p>
          </>
        ) : (
          <>
            <div class="h-8 bg-gray-300 w-48 rounded mb-2" />
            <div class="h-4 bg-gray-300 w-24 rounded" />
          </>
        )
      }
    </div>
  </div>
</div>

<div id="bio-section" class={`px-4 mb-8 ${!creator ? "hidden" : ""}`}>
  <p id="profile-about" class="text-gray-700 whitespace-pre-wrap mb-6">
    {creator?.story || creator?.about || ""}
  </p>
  <div id="profile-stats-grid" class="flex flex-wrap gap-x-6 gap-y-3">
    {
      statItems.map((item) => (
        <div class="flex flex-col items-start min-w-[60px]">
          <span class="text-sm font-bold text-gray-900 leading-tight">
            {item.value}
          </span>
          <span class="text-[9px] text-gray-400 font-bold uppercase tracking-wider leading-tight">
            {item.label}
          </span>
        </div>
      ))
    }
  </div>
</div>
