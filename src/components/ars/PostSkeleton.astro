---
/**
 * PostSkeleton component for Arsmate.
 * Used for SSR initial loading states.
 */
interface Props {
    viewMode?: "grid" | "list";
    count?: number;
}

const { viewMode = "grid", count = 4 } = Astro.props;
---

<div class={`grid grid-cols-1 ${viewMode === 'grid' ? 'sm:grid-cols-2' : ''} gap-6`}>
    {Array.from({ length: count }).map((_) => (
        <div class="bg-white dark:bg-slate-900 rounded-xl shadow-sm overflow-hidden border border-gray-100 dark:border-slate-800 animate-pulse h-full flex flex-col">
            <!-- Header Skeleton -->
            <header class="p-4 flex justify-between items-center border-b border-gray-50 dark:border-slate-800">
                <div class="flex items-center gap-2">
                    <div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-slate-800 shadow-inner"></div>
                    <div class="space-y-1.5">
                        <div class="h-3 bg-gray-200 dark:bg-slate-800 w-24 rounded"></div>
                        <div class="h-2 bg-gray-200 dark:bg-slate-800 w-12 rounded"></div>
                    </div>
                </div>
                <div class="flex gap-3">
                    <div class="w-8 h-3 bg-gray-100 dark:bg-slate-800 rounded"></div>
                    <div class="w-8 h-3 bg-gray-100 dark:bg-slate-800 rounded"></div>
                </div>
            </header>

            <!-- Content Skeleton -->
            <div class="p-4 flex-grow flex flex-col">
                <div class="space-y-2 mb-4">
                    <div class="h-3 bg-gray-100 dark:bg-slate-800 w-full rounded"></div>
                    <div class="h-3 bg-gray-100 dark:bg-slate-800 w-3/4 rounded"></div>
                </div>

                <!-- Media Placeholder -->
                <div class="aspect-square bg-gray-100 dark:bg-slate-800 rounded-lg mb-4"></div>

                <!-- Footer Skeleton -->
                <div class="mt-auto pt-4 border-t border-gray-50 dark:border-slate-800 flex justify-between items-center">
                    <div class="h-2 bg-gray-100 dark:bg-slate-800 w-16 rounded"></div>
                    <div class="h-5 bg-gray-100 dark:bg-slate-800 w-12 rounded-full"></div>
                </div>
            </div>
        </div>
    ))}
</div>
