---
// Card fantasma que imita la estructura de PostCard (header, texto, media,
// footer) mientras se carga el feed. Misma fuente para el SSR (primer paint) y
// para el clon en JS (re-layout al cambiar de filtros).
interface Props {
  tall?: boolean;
}
const { tall = false } = Astro.props;
---

<div
  class="skeleton-card bg-white rounded-xl shadow-sm overflow-hidden border border-gray-100 animate-pulse"
>
  <div class="p-4 flex items-center gap-2 border-b border-gray-50">
    <div class="w-8 h-8 rounded-full bg-gray-200 flex-shrink-0"></div>
    <div class="flex-1 space-y-1.5">
      <div class="h-3 w-24 bg-gray-200 rounded"></div>
      <div class="h-2 w-16 bg-gray-100 rounded"></div>
    </div>
  </div>
  <div class="p-4">
    <div class="space-y-2 mb-4">
      <div class="h-3 w-full bg-gray-200 rounded"></div>
      <div class="h-3 w-2/3 bg-gray-200 rounded"></div>
    </div>
    <div
      class:list={[tall ? "aspect-[3/4]" : "aspect-square", "bg-gray-200 rounded-lg"]}
    >
    </div>
    <div
      class="mt-4 pt-4 border-t border-gray-50 flex justify-between items-center"
    >
      <div class="h-2 w-16 bg-gray-100 rounded"></div>
      <div class="h-4 w-12 bg-gray-100 rounded-full"></div>
    </div>
  </div>
</div>
