---
// Autenticación de Arsmate como avatar con menú desplegable y modal, al estilo
// de `src/components/sheer/SheerAuth.astro` pero con el diseño (light/dark) de
// las páginas de Arsmate.
//
//  ┌── Avatar circular con punto flotante de estado (verde/rojo/gris/cargando).
//  │   Al hacer clic despliega un menú con las opciones de sesión.
//  └── El modal permite iniciar sesión con email+contraseña o pegar la cookie
//      `ars_mate_auth`, validar la sesión y cerrarla.
//
// Todo el trabajo pesado (login, validación, persistencia en KV) vive en
// /api/ars/auth; aquí solo está la UI + el fetch del cliente.
---

<div id="ars-auth-root" class="relative inline-block">
  {/* Avatar + punto de estado */}
  <button
    type="button"
    id="ars-auth-avatar"
    class="group relative flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-300 border border-slate-200 dark:border-slate-700 hover:bg-slate-200 dark:hover:bg-slate-700 transition-all shadow-sm"
    aria-haspopup="true"
    aria-expanded="false"
    title="Sesión de Arsmate"
  >
    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
    </svg>
    <span
      id="ars-auth-dot"
      class="absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-white dark:border-[#0a0a0a] bg-slate-400"
      title="Comprobando…"
    ></span>
  </button>

  {/* Menú desplegable */}
  <div
    id="ars-auth-menu"
    class="absolute right-0 top-[calc(100%+0.5rem)] z-50 hidden w-56 max-w-[calc(100vw-2rem)] origin-top-right overflow-hidden rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl"
    role="menu"
  >
    <div class="border-b border-slate-100 dark:border-slate-800 px-4 py-3">
      <p id="ars-auth-account" class="truncate text-sm font-semibold text-slate-900 dark:text-slate-100">
        Sesión Arsmate
      </p>
      <p id="ars-auth-status" class="mt-0.5 flex items-center gap-1.5 text-xs font-semibold text-slate-400 dark:text-slate-500">
        <svg class="h-3.5 w-3.5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>
        Comprobando…
      </p>
    </div>
    <div class="p-1.5">
      <button type="button" data-open="account" class="ars-menu-item flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm text-slate-700 dark:text-slate-200 transition-colors hover:bg-slate-100 dark:hover:bg-slate-800" role="menuitem">
        <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H3m0 0l4-4m-4 4l4 4m5-9V6a2 2 0 012-2h5a2 2 0 012 2v12a2 2 0 01-2 2h-5a2 2 0 01-2-2v-1"></path></svg>
        Iniciar sesión
      </button>
      <button type="button" data-open="validate" class="ars-menu-item flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm text-slate-700 dark:text-slate-200 transition-colors hover:bg-slate-100 dark:hover:bg-slate-800" role="menuitem">
        <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
        Validar sesión
      </button>
      <button type="button" id="ars-auth-logout" class="ars-menu-item hidden w-full items-center gap-2.5 rounded-lg px-3 py-2 text-left text-sm text-rose-600 dark:text-rose-400 transition-colors hover:bg-rose-50 dark:hover:bg-rose-950/40" role="menuitem">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
        Cerrar sesión
      </button>
    </div>
  </div>
</div>

{/* Modal */}
<div id="ars-auth-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-3 sm:p-6" aria-hidden="true">
  <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" data-close></div>

  <div class="relative z-10 flex max-h-[calc(100dvh-1.5rem)] w-full max-w-[460px] flex-col overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-2xl">
    <div class="flex shrink-0 items-center justify-between gap-3 border-b border-slate-100 dark:border-slate-800 px-5 py-4">
      <h2 id="ars-auth-modal-title" class="flex items-center gap-2 text-base font-semibold text-slate-900 dark:text-slate-100">
        Autenticación
      </h2>
      <button type="button" data-close aria-label="Cerrar" class="flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    {/* Selector de método (login ↔ cookie) */}
    <div class="shrink-0 px-5 pt-4">
      <div class="flex rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 p-0.5">
        <button type="button" data-goto="login" class="ars-tab flex-1 rounded-md px-3 py-1.5 text-sm font-semibold text-slate-500 dark:text-slate-400 transition-colors">
          Usuario y clave
        </button>
        <button type="button" data-goto="cookies" class="ars-tab flex-1 rounded-md px-3 py-1.5 text-sm font-semibold text-slate-500 dark:text-slate-400 transition-colors">
          Cookie
        </button>
      </div>
    </div>

    <div class="overflow-y-auto px-5 py-4">
      {/* Método 1: email + contraseña */}
      <div data-view="login" class="ars-view hidden flex-col gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="ars-auth-email" class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Email</label>
          <input type="email" id="ars-auth-email" autocomplete="username" placeholder="tu@email.com" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-sm text-slate-800 dark:text-slate-100 outline-none transition-all focus:border-blue-400 focus:ring-2 focus:ring-blue-100 dark:focus:ring-slate-700" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="ars-auth-password" class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Contraseña</label>
          <input type="password" id="ars-auth-password" autocomplete="current-password" placeholder="••••••••" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-sm text-slate-800 dark:text-slate-100 outline-none transition-all focus:border-blue-400 focus:ring-2 focus:ring-blue-100 dark:focus:ring-slate-700" />
        </div>
        <button type="button" id="ars-auth-login" class="mt-1 w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-700">
          Iniciar sesión
        </button>
        <p class="text-xs italic text-slate-400 dark:text-slate-500">Las credenciales se envían al servidor solo para obtener la cookie; no se guardan.</p>
      </div>

      {/* Método 2: pegar cookie */}
      <div data-view="cookies" class="ars-view hidden flex-col gap-3">
        <div class="flex flex-col gap-1.5">
          <label for="ars-auth-label" class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Nombre de la sesión <span class="normal-case text-slate-400/70">(opcional)</span></label>
          <input type="text" id="ars-auth-label" placeholder="p. ej. Mi cuenta" class="w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 text-sm text-slate-800 dark:text-slate-100 outline-none transition-all focus:border-blue-400 focus:ring-2 focus:ring-blue-100 dark:focus:ring-slate-700" />
        </div>
        <div class="flex flex-col gap-1.5">
          <label for="ars-auth-cookie" class="text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">Cookie de sesión</label>
          <textarea id="ars-auth-cookie" rows="4" placeholder="Pega el valor de ars_mate_auth, la cabecera «ars_mate_auth=…» o el JSON de cookies." class="w-full resize-y rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-3.5 py-2.5 font-mono text-xs text-slate-800 dark:text-slate-100 outline-none transition-all focus:border-blue-400 focus:ring-2 focus:ring-blue-100 dark:focus:ring-slate-700"></textarea>
        </div>
        <button type="button" id="ars-auth-save" class="mt-1 w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-700">
          Guardar y validar
        </button>
      </div>

      {/* Método 3: validar sesión guardada */}
      <div data-view="validate" class="ars-view hidden flex-col gap-3">
        <p class="text-sm text-slate-500 dark:text-slate-400">Comprueba si la sesión guardada en el servidor sigue activa.</p>
        <button type="button" id="ars-auth-validate" class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-blue-700">
          Validar sesión
        </button>
      </div>

      <p id="ars-auth-result" class="mt-4 text-sm text-slate-500 dark:text-slate-400 empty:hidden"></p>
    </div>
  </div>
</div>

<script is:inline>
  (() => {
    const root = document.getElementById("ars-auth-root");
    if (!root) return;

    const avatar = document.getElementById("ars-auth-avatar");
    const menu = document.getElementById("ars-auth-menu");
    const statusEl = document.getElementById("ars-auth-status");
    const accountEl = document.getElementById("ars-auth-account");
    const dot = document.getElementById("ars-auth-dot");
    const logoutBtn = document.getElementById("ars-auth-logout");
    const modal = document.getElementById("ars-auth-modal");
    const modalTitle = document.getElementById("ars-auth-modal-title");
    const result = document.getElementById("ars-auth-result");
    const views = modal.querySelectorAll(".ars-view");
    const tabs = modal.querySelectorAll(".ars-tab");

    // El header es sticky con backdrop-blur (containing block para position:fixed):
    // movemos el modal a <body> para que `fixed inset-0` cubra todo el viewport.
    if (modal.parentElement !== document.body) document.body.appendChild(modal);

    let lastFocus = null;

    // ── Menú ──────────────────────────────────────────────────────────────────
    const openMenu = () => {
      menu.classList.remove("hidden");
      avatar.setAttribute("aria-expanded", "true");
    };
    const closeMenu = () => {
      menu.classList.add("hidden");
      avatar.setAttribute("aria-expanded", "false");
    };
    avatar?.addEventListener("click", (e) => {
      e.stopPropagation();
      menu.classList.contains("hidden") ? openMenu() : closeMenu();
    });
    document.addEventListener("click", (e) => {
      if (!root.contains(e.target)) closeMenu();
    });

    // ── Modal ─────────────────────────────────────────────────────────────────
    const TITLES = {
      login: "Iniciar sesión",
      cookies: "Pegar cookie",
      validate: "Validar sesión",
    };
    const TABBED = new Set(["login", "cookies"]);

    const showView = (view) => {
      views.forEach((v) => {
        const active = v.getAttribute("data-view") === view;
        v.classList.toggle("hidden", !active);
        v.classList.toggle("flex", active);
      });
      tabs.forEach((t) => {
        const active = t.getAttribute("data-goto") === view;
        t.classList.toggle("bg-white", active);
        t.classList.toggle("dark:bg-slate-700", active);
        t.classList.toggle("text-slate-900", active);
        t.classList.toggle("dark:text-white", active);
        t.classList.toggle("shadow-sm", active);
        t.classList.toggle("text-slate-500", !active);
        t.classList.toggle("dark:text-slate-400", !active);
      });
      // El selector de pestañas solo aplica a los métodos de login/cookie.
      const tabBar = tabs[0]?.parentElement?.parentElement;
      if (tabBar) tabBar.classList.toggle("hidden", !TABBED.has(view));
      if (modalTitle) modalTitle.textContent = TITLES[view] || "Autenticación";
      setResult("", "");
      if (view === "validate") document.getElementById("ars-auth-validate")?.click();
    };

    const openModal = (view) => {
      showView(view);
      lastFocus = document.activeElement;
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
    };
    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    };

    root.querySelectorAll(".ars-menu-item").forEach((item) => {
      const open = item.getAttribute("data-open");
      if (!open) return; // logout se maneja aparte
      item.addEventListener("click", () => {
        closeMenu();
        openModal(open === "account" ? "login" : open);
      });
    });
    tabs.forEach((t) => t.addEventListener("click", () => showView(t.getAttribute("data-goto"))));
    // Otras partes de la app (p. ej. el estado "sin sesión" del feed) pueden pedir
    // abrir el login directamente disparando este evento.
    document.addEventListener("ars-auth:open", () => {
      closeMenu();
      openModal("login");
    });
    modal.querySelectorAll("[data-close]").forEach((el) => el.addEventListener("click", closeModal));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
    });

    // ── Estado (punto flotante + texto del menú) ────────────────────────────────
    const spinner =
      '<svg class="h-3.5 w-3.5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path></svg>';
    const iconOk = '<svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>';
    const iconBad = '<svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>';

    const setStatus = (state, text) => {
      const map = {
        loading: { dot: "bg-slate-400", txt: "text-slate-400 dark:text-slate-500", icon: spinner },
        ok: { dot: "bg-emerald-500", txt: "text-emerald-600 dark:text-emerald-400", icon: iconOk },
        bad: { dot: "bg-rose-500", txt: "text-rose-600 dark:text-rose-400", icon: iconBad },
      };
      const s = map[state] || map.loading;
      if (dot) {
        dot.className = `absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-white dark:border-[#0a0a0a] ${s.dot}`;
        dot.title = text;
      }
      if (statusEl) {
        statusEl.className = `mt-0.5 flex items-center gap-1.5 text-xs font-semibold ${s.txt}`;
        statusEl.innerHTML = `${s.icon} ${text}`;
      }
    };

    const setResult = (state, text) => {
      if (!result) return;
      const cls = state === "ok" ? "text-emerald-600 dark:text-emerald-400" : state === "bad" ? "text-rose-600 dark:text-rose-400" : "text-slate-500 dark:text-slate-400";
      result.className = `mt-4 text-sm empty:hidden ${cls}`;
      result.textContent = text;
    };

    const busy = (btn, on, label) => {
      if (!btn) return;
      if (on) {
        btn.dataset._html = btn.innerHTML;
        btn.disabled = true;
        btn.style.opacity = "0.6";
        btn.innerHTML = label;
      } else {
        btn.disabled = false;
        btn.style.opacity = "";
        if (btn.dataset._html) btn.innerHTML = btn.dataset._html;
      }
    };

    const api = async (method, payload) => {
      const opts = { method };
      if (payload) {
        opts.headers = { "content-type": "application/json" };
        opts.body = JSON.stringify(payload);
      }
      const res = await fetch("/api/ars/auth", opts);
      return res.json();
    };

    const applyAccount = (account) => {
      const label = account?.label || "Sesión Arsmate";
      if (accountEl) accountEl.textContent = label;
      // Solo ofrecemos cerrar sesión cuando el usuario ha establecido una (no la de env).
      const canLogout = account && account.source !== "env";
      if (logoutBtn) logoutBtn.classList.toggle("hidden", !canLogout);
      if (logoutBtn) logoutBtn.classList.toggle("flex", !!canLogout);
    };

    // ── Estado inicial ──────────────────────────────────────────────────────────
    const refreshStatus = async () => {
      setStatus("loading", "Comprobando…");
      try {
        const data = await api("GET");
        applyAccount(data.account);
        if (data.valid) setStatus("ok", "Sesión activa");
        else setStatus("bad", data.reason || "Sin sesión");
        return data;
      } catch {
        setStatus("bad", "Error");
        return { valid: false };
      }
    };

    // ── Validar ─────────────────────────────────────────────────────────────────
    document.getElementById("ars-auth-validate")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      busy(btn, true, "Validando…");
      const data = await refreshStatus();
      setResult(data.valid ? "ok" : "bad", data.valid ? "Sesión activa ✓" : `Sesión inactiva — ${data.reason || "sin sesión"}`);
      busy(btn, false);
    });

    // ── Guardar cookie ──────────────────────────────────────────────────────────
    document.getElementById("ars-auth-save")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const cookie = document.getElementById("ars-auth-cookie")?.value.trim();
      const label = document.getElementById("ars-auth-label")?.value.trim();
      if (!cookie) return setResult("bad", "Pega la cookie primero.");
      busy(btn, true, "Guardando…");
      try {
        const data = await api("POST", { action: "save", cookie, label });
        if (data.ok) {
          applyAccount(data.account);
          setStatus(data.valid ? "ok" : "bad", data.valid ? "Sesión activa" : "Sesión inactiva");
          setResult(data.valid ? "ok" : "bad", data.valid ? "Cookie guardada — sesión activa ✓" : `Guardada — pero ${data.reason || "sesión inactiva"}`);
          // Sesión válida: recargamos para que la página refleje el contenido.
          if (data.valid) setTimeout(() => location.reload(), 700);
        } else {
          setResult("bad", data.error || "No se pudo guardar la cookie.");
        }
      } catch {
        setResult("bad", "Error de red al guardar.");
      }
      busy(btn, false);
    });

    // ── Login email/contraseña ──────────────────────────────────────────────────
    document.getElementById("ars-auth-login")?.addEventListener("click", async (e) => {
      const btn = e.currentTarget;
      const email = document.getElementById("ars-auth-email")?.value.trim();
      const password = document.getElementById("ars-auth-password")?.value;
      if (!email || !password) return setResult("bad", "Email y contraseña son requeridos.");
      busy(btn, true, "Iniciando sesión…");
      try {
        const data = await api("POST", { action: "login", email, password });
        if (data.ok) {
          applyAccount(data.account);
          setStatus("ok", "Sesión activa");
          setResult("ok", "Sesión iniciada ✓");
          const pw = document.getElementById("ars-auth-password");
          if (pw) pw.value = "";
          // Recargamos para que la página refleje el contenido con la sesión.
          setTimeout(() => location.reload(), 700);
        } else {
          setStatus("bad", "Sesión inactiva");
          setResult("bad", data.error || "Login fallido.");
        }
      } catch {
        setResult("bad", "Error de red en el login.");
      }
      busy(btn, false);
    });

    // ── Cerrar sesión ───────────────────────────────────────────────────────────
    logoutBtn?.addEventListener("click", async () => {
      closeMenu();
      try {
        await api("POST", { action: "logout" });
      } catch {}
      applyAccount(null);
      await refreshStatus();
    });

    refreshStatus();
  })();
</script>
